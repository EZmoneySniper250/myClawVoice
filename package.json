{
  "name": "myvoice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local real-time voice chat page for October/OpenClaw.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "start": "node dist/server.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "probe:openclaw": "tsx src/scripts/probe-openclaw.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.46.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "ioredis": "^5.10.1",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
