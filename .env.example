# MyVoice local server
PORT=8787
HOST=0.0.0.0

# Agent identity — override to personalize your AI
AGENT_NAME=October

# LLM — OpenAI 兼容接口（OpenClaw 或其他）
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_API_KEY=
OPENCLAW_MODEL=openclaw/default
OPENCLAW_SESSION_KEY=myvoice-october
OPENCLAW_MESSAGE_CHANNEL=myvoice

# STT mode: mock | faster-whisper | funasr
STT_MODE=mock
PYTHON_BIN=python
# faster-whisper options: tiny | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_LANGUAGE=zh
# 1 = fastest; 5 = most accurate
WHISPER_BEAM_SIZE=1
# funasr model (only used when STT_MODE=funasr)
FUNASR_MODEL=paraformer-zh

# TTS mode: mock | elevenlabs | doubao
TTS_MODE=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# DOUBAO_TTS_API_KEY=
# DOUBAO_TTS_MODEL=doubao-tts
# DOUBAO_TTS_REALTIME_URL=wss://ai-gateway.vei.volces.com/v1/realtime
# DOUBAO_TTS_VOICE=zh_female_kailangjiejie_moon_bigtts
# DOUBAO_TTS_SAMPLE_RATE=24000
# DOUBAO_TTS_FORMAT=pcm
# # Optional — only needed for certain Volcengine resource routes
# DOUBAO_TTS_RESOURCE_ID=

# Redis — chat history persistence (optional, omit to run without history)
# REDIS_URL=redis://localhost:6379
