# MyVoice local server
PORT=8787
HOST=127.0.0.1

# OpenClaw Gateway
OPENCLAW_BASE_URL=http://127.0.0.1:18789
# Put your Gateway password/token here. Do not commit .env.
OPENCLAW_API_KEY=
OPENCLAW_MODEL=openclaw/default
# Dedicated voice-chat session so Telegram/current chat does not get polluted.
OPENCLAW_SESSION_KEY=myvoice-october
OPENCLAW_MESSAGE_CHANNEL=myvoice

# STT mode: mock | faster-whisper
STT_MODE=mock
# Python executable to use when STT_MODE=faster-whisper
PYTHON_BIN=python
# Suggested later: small, medium, large-v3, distil-large-v3. Chinese quality improves with bigger models.
WHISPER_MODEL=small
WHISPER_LANGUAGE=zh
# 1 is fastest for interactive chat; raise to 5 if you prefer accuracy over latency.
WHISPER_BEAM_SIZE=1

# TTS mode: mock | doubao | elevenlabs
# elevenlabs = ElevenLabs sentence-level TTS over existing WebSocket audio events.
# doubao = Realtime bidirectional TTS over WebSocket.
TTS_MODE=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

DOUBAO_TTS_API_KEY=
DOUBAO_TTS_MODEL=doubao-tts
DOUBAO_TTS_REALTIME_URL=wss://ai-gateway.vei.volces.com/v1/realtime
DOUBAO_TTS_VOICE=zh_female_kailangjiejie_moon_bigtts
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_TTS_FORMAT=pcm
# Optional. Only needed for some self-owned/third-party resource routes.
DOUBAO_TTS_RESOURCE_ID=

# Legacy HTTP TTS fields kept for later fallback experiments.
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
DOUBAO_VOICE_TYPE=
